{
  "name": "talentral",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @talentral/web dev",
    "build": "pnpm --filter @talentral/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @talentral/db migrate",
    "db:seed": "pnpm --filter @talentral/db seed"
  }
}
