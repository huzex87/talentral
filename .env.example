# Postgres connection for the app (Supabase: use the pooled connection string in production).
DATABASE_URL=postgres://talentral:talentral@localhost:5432/talentral_dev
# Optional: a session connection for migrations (Supabase session pooler, port 5432). Hosted apps use the
# transaction pooler (port 6543) for DATABASE_URL; Vercel builds run migrations and the seed first.
MIGRATION_DATABASE_URL=
# Separate database used by the RLS and integration tests (it is reset by the tests).
DATABASE_URL_TEST=postgres://talentral:talentral@localhost:5432/talentral_test
# Public base URL, used in emailed links. Hub subdomains resolve when ROOT_DOMAIN is set (for example talentral.co).
APP_URL=http://localhost:3000
ROOT_DOMAIN=
# Production: ROOT_DOMAIN=talentral.ng (hub pages at <hub>.talentral.ng; needs a wildcard DNS record)
# Comma-separated emails that become platform admins when you run pnpm db:seed.
PLATFORM_ADMIN_EMAILS=huzexng@gmail.com
# Email: "console" (log), "file" (write to .mail/, used by tests) or "resend" (needs RESEND_API_KEY and MAIL_FROM).
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Talentral <no-reply@talentral.ng>
# SMS: "console" (log), "file" (write to .sms/, used by tests) or "termii" (needs TERMII_API_KEY and an approved sender ID).
SMS_DRIVER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Talentral
# "generic" for promotional routes; "dnd" (after Termii approval) also reaches numbers on the Do-Not-Disturb list.
TERMII_CHANNEL=generic
# WhatsApp (Meta WhatsApp Business Cloud API): "off" (default), "console", "file" (write to .whatsapp/, used by tests) or "cloud".
# People who opt in get reminders, nudges, announcements, hub messages and sign-in codes on WhatsApp instead of SMS.
# Setup and the exact message templates to submit to Meta: docs/whatsapp.md.
WHATSAPP_DRIVER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook (STOP/START replies): verify token for Meta's check, and the app secret that signs each delivery.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional overrides (defaults shown): template names and language codes.
WHATSAPP_TEMPLATE_UPDATE=talentral_update
WHATSAPP_TEMPLATE_CODE=talentral_code
WHATSAPP_LANG_EN=en
WHATSAPP_LANG_HA=ha
# Streamed lesson video (Bunny Stream): "off" (default; YouTube or Vimeo links and plain uploads only), "fake" (tests) or
# "bunny". Setup: docs/video-streaming.md.
STREAM_DRIVER=off
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# The library's CDN hostname, for example vz-1a2b3c4d-5e6.b-cdn.net (Stream > library > API).
BUNNY_STREAM_CDN_HOST=
# Optional: embed view token authentication key, and the CDN token authentication key for the 360p MP4.
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_TOKEN_KEY=
# Secret added to the webhook URL set in the library: <APP_URL>/api/stream/webhook?secret=<this>
STREAM_WEBHOOK_SECRET=
# File storage: "local" (writes to .uploads/) or "s3" (Supabase Storage S3 endpoint or any S3-compatible bucket).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AI drafting (Claude). With ANTHROPIC_API_KEY set, hub teams see "Draft with AI" on programme, lesson, quiz and
# grading screens. AI_DRIVER=fake returns fixed drafts (used by the tests). Each hub gets this many drafts a day (WAT).
ANTHROPIC_API_KEY=
AI_DRIVER=
AI_DAILY_DRAFTS_PER_HUB=150
