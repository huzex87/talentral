# Postgres connection for the app (Supabase: use the pooled connection string in production).
DATABASE_URL=postgres://talentral:talentral@localhost:5432/talentral_dev
# Optional: a session connection for migrations (Supabase session pooler, port 5432). Hosted apps use the
# transaction pooler (port 6543) for DATABASE_URL; Vercel builds run migrations and the seed first.
MIGRATION_DATABASE_URL=
# Separate database used by the RLS and integration tests (it is reset by the tests).
DATABASE_URL_TEST=postgres://talentral:talentral@localhost:5432/talentral_test
# Public base URL, used in emailed links. Hub subdomains resolve when ROOT_DOMAIN is set (for example talentral.co).
APP_URL=http://localhost:3000
ROOT_DOMAIN=
# Production: ROOT_DOMAIN=talentral.ng (hub pages at <hub>.talentral.ng; needs a wildcard DNS record)
# Comma-separated emails that become platform admins when you run pnpm db:seed.
PLATFORM_ADMIN_EMAILS=huzexng@gmail.com
# Email: "console" (log), "file" (write to .mail/, used by tests) or "resend" (needs RESEND_API_KEY and MAIL_FROM).
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Talentral <no-reply@talentral.ng>
# File storage: "local" (writes to .uploads/) or "s3" (Supabase Storage S3 endpoint or any S3-compatible bucket).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
